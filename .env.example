# Public browser configuration only. Copy to .env.local for local development.
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your-project-key

# Server/local-admin only. Never use a VITE_ prefix or expose these values to a browser.
# Required only by `npm run provision:league-accounts` after migrations are applied.
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=sb_secret_your-project-key

# Set unique, non-committed passwords only when creating a previously unbound account.
LEAGUE_ACCOUNT_JAKIN_GOFF_PASSWORD=
LEAGUE_ACCOUNT_DINDI_PASSWORD=
LEAGUE_ACCOUNT_22ND_OBLOCK_PASSWORD=
LEAGUE_ACCOUNT_MIKU007_PASSWORD=
LEAGUE_ACCOUNT_ROD_WAVE_DISCIPLES_PASSWORD=
LEAGUE_ACCOUNT_TINTILINIC_PASSWORD=
